# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=opendeliobot
ODB_BIND_ADDRESS=127.0.0.1
ODB_HTTP_PORT=8080
# Leave empty to use http://localhost:${ODB_HTTP_PORT:-8080}.
ODB_PUBLIC_URL=
# Leave empty to inherit ODB_PUBLIC_URL.
ODB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set ODB_PUBLIC_URL to https:// followed by the same hostname.
# Requires ODB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
ODB_HTTPS_HOST=
ODB_BASE_IMAGE=ghcr.io/braand-web/opendeliobot:latest
ODB_LOCAL_IMAGE=opendeliobot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
ODB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
ODB_DATA_EXTERNAL=false
