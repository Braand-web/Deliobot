# Public hostname for automatic HTTPS (must resolve to this machine).
# Pairing links (`docker compose exec odb node dist-server/pair-cli.js`) point here.
DOMAIN=delio.example.com

# Engine CLIs baked into the image at build time (space-separated npm packages).
# Sign in afterwards with:  docker compose exec odb claude   (etc.)
ENGINES=@anthropic-ai/claude-code

# Optional: let people sign in with an emailed code instead of a pairing
# code. Addresses or @domain entries, comma-separated. Admins get full
# access; members get chat and approvals only. Left empty, Settings → Remote
# access manages the lists; one set here decides its list instead.
ODB_SIGNIN_EMAILS=
ODB_SIGNIN_MEMBER_EMAILS=

# Optional: send those codes through your own mail server instead of the
# OpenDeliobot account service, e.g. smtps://user%40example.com:PASSWORD@smtp.example.com:465
# (docs/self-hosting.md). FROM defaults to the user name when it is an address.
ODB_SIGNIN_SMTP_URL=
ODB_SIGNIN_SMTP_FROM=

# The server image this install runs. `./update.sh` writes this line: the stable
# version, pinned by digest. Leave it out to follow `latest` (every main push).
# ODB_IMAGE=

# Optional: "1" lets the Delio phone app pair by QR through Delio Relay,
# end-to-end encrypted, from anywhere. Sign the container in once first:
#   docker compose exec odb opendeliobot login --relay
# then: docker compose exec odb opendeliobot pair --phone
ODB_PHONE_RELAY=
