{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "deliobot-composio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "apps.deliobot.fun", "custom_domain": true }],
  "vars": {
    "COMPOSIO_API_BASE": "https://backend.composio.dev/api/v3.1",
    "COMPOSIO_TOOLKIT_BASE": "https://backend.composio.dev/api/v3",
    "REGISTRATION_MODE": "open"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deliobot-composio",
      "database_id": "b734b4c2-6d78-4134-b08e-7924c1b035e3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "8261701", "simple": { "limit": 30, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "8261702", "simple": { "limit": 120, "period": 60 } },
    { "name": "EVENTS_LIMITER", "namespace_id": "8261703", "simple": { "limit": 60, "period": 60 } }
  ],
  // No cron: the account's free slots are taken, so deliobot-portal calls the HourlySweep entrypoint every hour.
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
